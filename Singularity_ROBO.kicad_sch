	)
	(text "J2 = 2.4in ILI9341 240x320 SPI display\nwith XPT2046 resistive touch.  Touch shares\nthe SPI bus, T_CS on CE1 (GPIO7).\nBL = GPIO20 backlight, VCC = +5V."
		(exclude_from_sim no)
		(at 411.48 238.76 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "62e9c501-b3d8-52fa-b738-060a443477dd")
	)
	(text "7 .  ESP32-CAM VISION MODULE"
		(exclude_from_sim no)
		(at 240 213.36 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "77297f56-e259-5f15-bded-0d4cc81256e8")
	)
	(text "U3 PCA9685PW:  A0-A5 = GND (addr 0x40),\n~OE = GND (outputs enabled), EXTCLK = NC.\nVDD = +5V logic.  Servo V+ rail = +5V_SERVO\nrouted to J4-J7 headers. LED0-3 = CH0-3."
		(exclude_from_sim no)
		(at 360 160.02 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "82dce034-606c-5efd-b9f6-11f462988774")
	)
	(text "U6 = DEDICATED SERVO BUCK, high current.\nServo rail never loaded by Raspberry Pi."
		(exclude_from_sim no)
		(at 60.96 162.56 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "955df291-234c-562b-b506-e285123ec07f")
	)
