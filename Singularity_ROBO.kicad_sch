	(text "U1 GPIO MAP (all 26 GPIOs used)\nI2C  GPIO2/SDA + GPIO3/SCL -> U3 PCA9685\nSPI0 GPIO10/9/11 + CE0/CE1 -> J2 TFT\nCE0 = TFT_CS, CE1 = touch T_CS\nENA/ENB = PWM GPIO18 / GPIO13\nUART GPIO14/15 <-> U4 ESP32-CAM (crossed)\n5V from U5 ONLY - NEVER 11.1V\nBT audio -> Dubstep Pop 600 (wireless)"
		(exclude_from_sim no)
		(at 240 175.26 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "08aaa340-00e3-51a8-9acd-a3757dddcf84")
	)
	(text "Dubstep Pop 600 speaker: audio link is\nBLUETOOTH (wireless) from the Raspberry Pi.\nOnly +5V / GND are wired (power/charge)."
		(exclude_from_sim no)
		(at 470 316.23 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "29d7954c-fae3-509e-b37b-1a496951f7a1")
	)
	(text "2 .  MOTOR DRIVER  L298N"
		(exclude_from_sim no)
		(at 112 30.48 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "2f6f88a2-6d4a-5e0a-a467-5d77af5e84b3")
	)
	(text "M1 = LEFT wheel, M2 = RIGHT wheel\nOUT1/OUT2 = motor A, OUT3/OUT4 = motor B\nSENSE_A / SENSE_B tied to GND\n(no current-sense resistors fitted).\nENA / ENB = PWM from Pi GPIO18 / GPIO13.\nVS = +11V_MOTOR, VSS = +5V logic."
		(exclude_from_sim no)
		(at 112 139.7 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "30bb92e7-62fc-5077-8271-6fb92f3dfce9")
	)
	(text "1 .  POWER / BATTERY / REGULATORS"
		(exclude_from_sim no)
		(at 14 30.48 0)
		(effects
			(font
