	(text "ECHO DIVIDER (mandatory level shift)\nHC-SR04 ECHO = 5V logic, Pi GPIO = 3.3V\nR1 1kO / R2 2kO  ->  ECHO_3V3 = 3.33V\n(5V x 2k / 3k).  NEVER wire ECHO direct."
		(exclude_from_sim no)
		(at 145 290.83 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "d7331765-5c37-5276-be65-b86d2b063e0a")
	)
