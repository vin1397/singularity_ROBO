	(text "U5 / U6 = LM2596S-ADJ buck modules\n1 IN+   2 IN-   3 OUT+ (5.0V)   4 OUT-"
		(exclude_from_sim no)
		(at 60.96 118.11 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "ca487b5d-31dd-5550-bd4b-03c79825ad05")
	)
	(text "U0T (GPIO1) = TX -> Pi RXD  = ESP32_TX\nU0R (GPIO3) = RX <- Pi TXD  = ESP32_RX\nCamera / person detection / inference on Pi\n5V from +5V rail, GND common, rest NC."
		(exclude_from_sim no)
		(at 240 271.78 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
